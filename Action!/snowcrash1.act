PROC WAITKEY()
    BYTE CONSOL=$D01F
    WHILE CONSOL>6
    DO
    OD
RETURN



PROC MAIN()
    BYTE RTC1=18
    BYTE RTC2=19
    BYTE RTC3=20
    CARD TIME
    CARD GFXMEM=88
    CARD START, FINAL
    CARD POLY=53770
    CARD ADR

    RTC1=0
    RTC2=0  
    RTC3=0

    GRAPHICS(8)
    START=GFXMEM
    FINAL=START+(320/8*160)

    FOR ADR=START TO FINAL
    DO
        POKE(ADR, POLY)
    OD

    TIME=RTC2*256+RTC3
    PRINT("FINISHED IN ")
    PRINTC(TIME/50)
    PRINTE(" SECONDS")
    WAITKEY()
RETURN



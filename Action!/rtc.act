PROC WAITKEY()
    BYTE CONSOL=$D01F
    WHILE CONSOL>6
    DO
    OD
RETURN



PROC MAIN()
    BYTE RTC1=18
    BYTE RTC2=19
    BYTE RTC3=20
    CARD TIME

    RTC1=0
    RTC2=0  
    RTC3=0

    WAITKEY()

    TIME=RTC2*256+RTC3
    PRINT("FINISHED IN ")
    PRINTC(TIME/50)
    PRINTE(" SECONDS")
    WAITKEY()
RETURN



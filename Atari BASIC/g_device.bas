1100 REM CHECK G DEVICE IS PRESENT
1105 ? :? "CHECKING G DEVICE...";
1110 HATABS=794
1115 GDEVLOAD=1200:GDEVFOUND=1150:GDEVNOTFOUND=1190
1120 FOR X=0 TO 37 STEP 3
1122 D=PEEK(HATABS+X)
1125 IF D=0 THEN GOTO GDEVNOTFOUND
1130 H=PEEK(HATABS+1+X)+256*PEEK(HATABS+2+X)
1132 REM ? CHR$(D);": ";H
1135 IF CHR$(D)="G" THEN GDEV=X:GOTO GDEVFOUND
1140 NEXT X:GOTO GDEVNOTFOUND
1150 FOR A=2 TO 4 STEP 2
1160 AC=PEEK(H+A)+256*PEEK(H+A+1)
1170 IF PEEK(AC)<>96 THEN GOTO GDEVNOTFOUND
1180 NEXT A
1185 ? "OK":RETURN 
1190 ? "NOT FOUND":GDEVFORCEINIT=1
